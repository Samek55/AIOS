PORT=3001
NODE_ENV=development
AUTH_SECRET=change-me-before-production
ALLOWED_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=1048576

# Set DATABASE_URL to switch from file persistence to PostgreSQL.
# Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aios
DATABASE_URL=
# Production should use PostgreSQL. Only use this escape hatch for controlled demos.
ALLOW_FILE_STORAGE_IN_PRODUCTION=false

# Real AI integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Real payments integration
STRIPE_SECRET_KEY=
STRIPE_BASE_URL=https://api.stripe.com/v1
PAYMENT_CURRENCY=usd

# Leave true for local development if Stripe is not configured.
USE_MOCK_PAYMENTS=true
# Production should use Stripe. Only use this escape hatch for controlled demos.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
